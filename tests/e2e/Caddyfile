# TLS terminator for the E2E stack.
#
# The gateway only ever produces `https://<host>` origins for n8n instances, so
# the test needs real TLS in front of n8n rather than a plain-HTTP shortcut.
# The certificate comes from a throwaway CA generated by run.mjs; both Node
# processes trust it via NODE_EXTRA_CA_CERTS.

{
	admin off
	auto_https off
}

https://n8n.local:443, https://127.0.0.1:443 {
	tls /certs/server.crt /certs/server.key

	# n8n's own liveness endpoint, used by this container's healthcheck to
	# confirm TLS termination works before anything downstream starts.
	reverse_proxy n8n:5678 {
		# n8n streams responses; do not buffer.
		flush_interval -1
	}
}
