# =============================================================================
# n8n MCP Server — Environment Configuration
# =============================================================================
# An OAuth 2.1 MCP server for n8n that fronts n8n-mcp as a REMOTE connector (Claude
# Web / Desktop / Code, Microsoft 365 Copilot, Cursor, ...), where each user
# authenticates with THEIR OWN personal n8n API key.
#
#   Inbound  (AI client -> gateway):  OAuth 2.1 + PKCE, issued by this server
#   Consent  (user      -> gateway):  instance (from the URL) + username + key
#   Outbound (gateway   -> n8n-mcp):  x-n8n-url / x-n8n-key per request
#
# One connector URL per n8n instance:
#
#     https://${N8N_MCP_HOSTNAME}/i/<n8n-host>/mcp
#
# /!\ BEFORE FIRST START — replace EVERY value containing "CHANGE_ME" /!\
#
# One-shot, cross-platform (Windows / Linux / macOS):
#
#     node scripts/generate-env.mjs
#
# Deployment:
#   Local development:   docker compose -f docker-compose.development.yml up -d
#   Self-hosted Traefik: docker compose -f docker-compose.traefik.yml      up -d
#   Coolify:             configure env in the dashboard -> docker-compose.coolify.yml
# =============================================================================


# =============================================================================
# Stack Configuration
# =============================================================================

STACK_NAME=bg-n8n-mcp
TIME_ZONE=Etc/UTC

# production | staging | development
# `development` is the ONLY value that permits a plain-http PUBLIC_BASE_URL,
# the in-memory grant store, or N8N_ALLOW_PRIVATE_ADDRESSES=true.
ENVIRONMENT=production


# =============================================================================
# Images
# =============================================================================

# This gateway. Available tags: `latest`, `stable`, a major line (1), a minor
# line (1.0), or an exact version. `latest` is fine — this is our own image and
# we control when it ships.
N8N_MCP_IMAGE=ghcr.io/bauer-group/ip-n8n-mcpserver/bg-n8n-mcp
N8N_MCP_VERSION=latest

# The upstream MCP server this gateway fronts (github.com/czlonkowski/n8n-mcp).
# NOT our project, so it is pinned to an exact version and bumped deliberately.
#
# Do NOT pin below 2.51.2. Earlier versions fall back to the operator's own
# process-level n8n credentials when the tenant headers are missing
# (GHSA-jxx9-px88-pj69, CVSS 8.1), and below 2.47.4 the tenant URL is an SSRF
# primitive (GHSA-4ggg-h7ph-26qr). Note the image tag has no `v` prefix even
# though the git tag does.
BACKEND_IMAGE=ghcr.io/czlonkowski/n8n-mcp
BACKEND_VERSION=2.73.0
BACKEND_PORT=3000

# Redis — required in production; this is where every grant lives.
REDIS_IMAGE=redis
REDIS_VERSION=8-alpine

# Safety limits, not reservations. The working set is small: a few hundred
# bytes per grant, plus short-lived codes and rate-limit counters.
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEM_LIMIT=384m


# =============================================================================
# Hostnames & URLs (Traefik / Coolify only)
# =============================================================================

# Public hostname of the GATEWAY. Give it its own name — it is an OAuth
# authorization server, and sharing an origin with an n8n instance would put
# two different OAuth roles behind one certificate and one cookie scope.
#
# Three constraints that are not obvious and produce no useful error when
# broken, because Anthropic's broker calls this host server-to-server from
# its own infrastructure rather than from the user's machine:
#   * it must resolve to a PUBLIC address (no RFC1918, no CGNAT, no split DNS)
#   * it needs an A record — an AAAA-only host is unreachable for connectors
#   * it must not redirect to a different host; the Authorization header is
#     dropped across a cross-host redirect
N8N_MCP_HOSTNAME=n8n-mcp.example.com

# External Traefik network name (must already exist on the Docker host)
PROXY_NETWORK=EDGEPROXY

# Full public base URL. Baked into every OAuth document, so it must match what
# the user typed into the connector dialog exactly — scheme, host, no trailing
# slash.
PUBLIC_BASE_URL=https://${N8N_MCP_HOSTNAME}


# =============================================================================
# Local Ports (development only)
# =============================================================================

# Host port for the development compose file.
N8N_MCP_PORT=8000
# The upstream backend, published so you can curl it directly while debugging.
BACKEND_HOST_PORT=3000
REDIS_PORT=6379


# =============================================================================
# Which n8n instances may be addressed  (REQUIRED — set at least one)
# =============================================================================
# This is the security boundary of the whole gateway. The gateway refuses to
# start if both are empty: an empty allowlist is a deployment that forgot to
# say who it serves, not an instruction to serve everyone.
#
# Matched against a PARSED hostname, never a raw string — so userinfo
# (`ok.example.com@evil.tld`), ports, paths and unicode homoglyphs cannot slip
# through either form.

# Preferred form. Comma-separated exact hostnames and/or `*.suffix` wildcards.
# A list is auditable at a glance and has no way to accidentally mean
# "everything". A wildcard matches subdomains but NOT the apex, so
# `*.app.bauer-group.com` does not grant `app.bauer-group.com`.
#
#   N8N_ALLOWED_HOSTS=flow.kunde-a.app.bauer-group.com,flow.kunde-b.app.bauer-group.com
#   N8N_ALLOWED_HOSTS=*.app.bauer-group.com
N8N_ALLOWED_HOSTS=CHANGE_ME_ALLOWED_HOSTS

# Escape hatch for host sets a list cannot express. Anchors are added in code,
# so a pattern that forgets ^ or $ still cannot become a substring match.
# Escape the dots — an unescaped dot matches any character.
#
#   N8N_ALLOWED_HOST_PATTERN=flow\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.app\.bauer-group\.com
N8N_ALLOWED_HOST_PATTERN=

# Allow instances that resolve to private / loopback / link-local / CGNAT
# addresses. Keep false. With it true, an allowlisted name whose DNS points at
# 169.254.169.254 turns this gateway into a cloud-metadata reader.
# Only meaningful for development, and only accepted there.
N8N_ALLOW_PRIVATE_ADDRESSES=false

# Timeout for the key-validation probe against a user's n8n instance, in ms.
# Applies in full to the interactive login only. The token-refresh path caps it
# at 5000, because a refresh runs inside the MCP client's own budget — so
# raising this above 5000 changes login alone, while lowering it below 5000
# tightens both paths.
N8N_PROBE_TIMEOUT_MS=8000


# =============================================================================
# Secrets  (REQUIRED)
# =============================================================================

# Shared between the gateway and the backend; the gateway is the backend's only
# client. Must be >= 32 characters — the backend warns below that, and we
# refuse to start.
#   openssl rand -base64 32
N8N_MCP_AUTH_TOKEN=CHANGE_ME_UPSTREAM_AUTH_TOKEN

# Encrypts every stored n8n API key (AES-256-GCM) and peppers the hashes that
# key the token store. Must decode to EXACTLY 32 bytes.
#   openssl rand -base64 32
#
# Rotating this is the break-glass revocation lever: every grant becomes
# undecryptable at once and every user simply reconnects. There is no partial
# rotation — do not change it casually.
AUTH_STORAGE_ENCRYPTION_KEY=CHANGE_ME_STORAGE_ENCRYPTION_KEY


# =============================================================================
# OAuth
# =============================================================================

# Where grants live. Required outside development — the in-memory fallback
# loses every grant on restart, so a routine image update would silently
# disconnect everyone.
AUTH_REDIS_URL=redis://redis:6379/0

# Token lifetimes, in seconds. Short access tokens plus rotating refresh tokens
# is what OAuth 2.1 asks of a public client, and the refresh path is where a
# revoked n8n key gets noticed.
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=120

# How long a DYNAMICALLY REGISTERED client record survives. 90 days.
#
# The record is read on exactly one path — /authorize. The token exchange, the
# refresh and the proxy never look a client up, so expiry cannot break a live
# connector; it can only fail a NEW authorization. The floor is therefore the
# refresh lifetime (30 days, extended on every use): a user must be inactive
# longer than this before it matters, and a DCR client that finds its
# registration gone simply registers again, which it does on reconnect anyway.
#
# The other side is Redis. Registration is unauthenticated, so the worst case is
# RATE_LIMITER_REGISTER_MAX x this TTL of ~334-byte records from one address:
#
#     90d -> ~21 MB      365d -> ~84 MB      690d -> ~158 MB
#
# The deployed store runs `maxmemory 256mb` with `maxmemory-policy noeviction`,
# where full does not mean "evict something" — it means no further grant or
# token can be written. Raising this means raising REDIS_MAXMEMORY with it.
AUTH_CLIENT_TTL=7776000

# How long a fetched Client ID Metadata Document is cached. One hour.
#
# NOT the same thing as AUTH_CLIENT_TTL, which is why it is its own setting. A
# CIMD record is a COPY of a document the client publishes and controls, so
# losing it costs one refetch — while KEEPING it too long is the expensive
# mistake: nothing revalidates a cached record, so a client that rotates its
# redirect URIs is rejected with `invalid_redirect` for exactly this long, with
# no cure but flushing the store. Maximum is one day.
AUTH_CIMD_CACHE_TTL=3600

# Optional allowlist of redirect-URI PREFIXES accepted at client registration.
# Empty means any acceptable URI may register, which is the MCP default and is
# what lets a client we have never heard of connect. Restrict it if this
# deployment only ever serves Claude:
#
#   MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/,https://claude.com/
#
# Note that restricting it also blocks Claude Code, which is an RFC 8252 native
# client on http://localhost/callback.
MCP_ALLOWED_CLIENT_REDIRECT_URIS=


# =============================================================================
# Rate limiting
# =============================================================================

RATE_LIMITER_ENABLED=true

# Failed key submissions before the consent form locks out. Counted per client
# IP AND per typed username: IP alone punishes a whole office for one typo,
# username alone lets an attacker spread guesses across names.
# Only a credential verdict counts — an unreachable instance never locks
# anyone out.
RATE_LIMITER_LOGIN_MAX=10
RATE_LIMITER_LOGIN_WINDOW=900

# Client registrations per IP per window. /register is unauthenticated — that
# is what lets an unknown client connect — and every accepted call writes a
# record that lives for AUTH_CLIENT_TTL.
#
# Generous rather than tight, because the traffic being bounded looks the same
# as legitimate traffic: DCR clients mint a fresh record on every reconnect,
# and a whole office arrives from one NAT address. 30/hour per IP is far above
# what reconnecting humans produce and far below what makes filling a store
# worthwhile.
RATE_LIMITER_REGISTER_MAX=30
RATE_LIMITER_REGISTER_WINDOW=3600

# Client ID Metadata Document fetches per IP per window.
#
# Resolving a CIMD client id means this gateway resolves and fetches a URL the
# caller named, from an unauthenticated request. The guards on that fetch
# (https only, public addresses only, no redirects, 32 KB, 4s) bound what one
# call can do; this bounds how many there are.
#
# Only UNCACHED resolutions count, so the everyday case — the same few AI
# clients reconnecting — never touches this budget, while an attacker naming a
# fresh URL each time is always a cache miss and always pays.
RATE_LIMITER_CIMD_MAX=30
RATE_LIMITER_CIMD_WINDOW=3600

# Token-endpoint attempts per client IP per window.
RATE_LIMITER_TOKEN_MAX=60
RATE_LIMITER_TOKEN_WINDOW=60

# MCP calls per grant per window. 0 disables just this limiter. 600/60s is
# generous for interactive use and still bounds a runaway agent loop.
RATE_LIMITER_MCP_MAX=600
RATE_LIMITER_MCP_WINDOW=60

# How many proxies sit in front of the gateway. 1 = a single Traefik; 2 if you
# stack Cloudflare in front of it; 0 for the development compose file, which
# publishes the port directly.
#
# This decides WHICH X-Forwarded-For entry is trusted. The header is
# append-only and its left end is whatever the caller wrote, so a wrong value
# here lets anyone choose their own rate-limit bucket by setting a header.
RATE_LIMITER_TRUSTED_PROXY_HOPS=1


# =============================================================================
# Observability
# =============================================================================

# json for production (one object per line, `docker compose logs | jq`),
# console for a readable local run.
LOG_FORMAT=json
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Shown on the consent screen and in the connector's display name.
MCP_DISPLAY_NAME=BAUER GROUP n8n
MCP_WEBSITE_URL=https://go.bauer-group.com/mcp-server


# =============================================================================
# Upstream backend tuning  (n8n-mcp)
# =============================================================================

# Session strategy. `instance` (the upstream default) keys sessions by the
# x-instance-id header, which the gateway sets PER GRANT — so each user gets
# their own session and a reconnect cleans up that user's stale one.
MULTI_TENANT_SESSION_STRATEGY=instance

# Allow one grant to hold several concurrent sessions. Off by default: with it
# off, a reconnect evicts the previous session for that grant, which is what
# stops sessions accumulating. Turn on if a single connector needs several
# live sessions at once.
MULTI_TENANT_ALLOW_CONCURRENT_SESSIONS=false

# Upper bound on concurrent backend sessions across all tenants.
BACKEND_MAX_SESSIONS=200

# The backend's own limiter counts FAILED requests per client IP (successes are
# skipped), so this is a brute-force guard rather than a throughput cap. The
# per-user throughput budget is RATE_LIMITER_MCP_MAX on the gateway.
BACKEND_AUTH_RATE_LIMIT_MAX=100
BACKEND_AUTH_RATE_LIMIT_WINDOW=900000

# SSRF policy the backend applies to the tenant URL the gateway sends.
#   strict     — blocks localhost, private ranges and cloud metadata (keep this)
#   moderate   — allows localhost, blocks private ranges
#   permissive — allows both; blocks cloud metadata only
# `strict` requires your n8n instances to be reachable over public HTTPS. If
# they are not, prefer fixing that over loosening this: with `permissive`, the
# gateway's allowlist becomes the only SSRF control in the stack.
WEBHOOK_SECURITY_MODE=strict

# Optional guardrails, comma-separated. Example for a read-only deployment:
#   DISABLED_TOOLS=n8n_delete_workflow,n8n_delete_execution
#   DISABLED_TOOL_OPERATIONS=n8n_update_partial_workflow:*
DISABLED_TOOLS=
DISABLED_TOOL_OPERATIONS=

BACKEND_LOG_LEVEL=info
